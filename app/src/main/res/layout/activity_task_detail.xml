<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Traka boje kategorije na vrhu -->
        <View
            android:id="@+id/viewCategoryColorBar"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginBottom="16dp"
            android:background="#3F51B5"/>

        <!-- Naziv zadatka -->
        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Naziv zadatka"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="8dp"/>

        <!-- Status badge -->
        <TextView
            android:id="@+id/tvDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AKTIVAN"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:background="#4CAF50"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- Kartica sa detaljima -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Opis -->
                <TextView
                    android:text="Opis"
                    android:textStyle="bold"
                    android:textColor="#616161"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp"/>

                <!-- Kategorija -->
                <TextView
                    android:text="Kategorija"
                    android:textStyle="bold"
                    android:textColor="#616161"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp"/>

                <!-- Težina -->
                <TextView
                    android:text="Težina"
                    android:textStyle="bold"
                    android:textColor="#616161"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvDetailDifficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp"/>

                <!-- Bitnost -->
                <TextView
                    android:text="Bitnost"
                    android:textStyle="bold"
                    android:textColor="#616161"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvDetailImportance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp"/>

                <!-- Ukupno XP -->
                <TextView
                    android:text="Ukupno XP"
                    android:textStyle="bold"
                    android:textColor="#616161"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvDetailXP"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 XP"
                    android:textColor="#FF9800"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Datum početka -->
                <TextView
                    android:text="Datum početka"
                    android:textStyle="bold"
                    android:textColor="#616161"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvDetailStartDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp"/>

                <!-- Datum završetka (samo za ponavljajuće) -->
                <TextView
                    android:id="@+id/labelEndDate"
                    android:text="Datum završetka"
                    android:textStyle="bold"
                    android:textColor="#616161"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvDetailEndDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#212121"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp"/>

                <!-- Učestalost -->
                <TextView
                    android:text="Učestalost"
                    android:textStyle="bold"
                    android:textColor="#616161"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvDetailFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#212121"
                    android:layout_marginBottom="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Dugmad za akcije -->
        <Button
            android:id="@+id/btnMarkDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ Označi kao urađen"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏸ Pauziraj"
            android:backgroundTint="#FF9800"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ Aktiviraj"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✕ Otkaži zadatak"
            android:backgroundTint="#F44336"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✎ Izmeni zadatak"
            android:backgroundTint="#607D8B"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗑 Obriši zadatak"
            android:backgroundTint="#B71C1C"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>
</ScrollView>