<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:text="Novi zadatak"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Naziv -->
        <TextView android:text="Naziv *"
            android:textColor="#616161"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/inputTaskName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unesite naziv zadatka"
            android:background="@android:color/white"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- Opis -->
        <TextView android:text="Opis (opciono)"
            android:textColor="#616161"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/inputTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unesite opis"
            android:minLines="2"
            android:background="@android:color/white"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- Kategorija -->
        <TextView android:text="Kategorija *"
            android:textColor="#616161"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- Težina -->
        <TextView android:text="Težina *"
            android:textColor="#616161"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Spinner
            android:id="@+id/spinnerDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- Bitnost -->
        <TextView android:text="Bitnost *"
            android:textColor="#616161"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Spinner
            android:id="@+id/spinnerImportance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- Učestalost -->
        <TextView android:text="Učestalost *"
            android:textColor="#616161"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <RadioGroup
            android:id="@+id/radioGroupFrequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <RadioButton
                android:id="@+id/radioOneTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jednokratni"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/radioRepeating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ponavljajući"
                android:layout_marginStart="16dp"/>
        </RadioGroup>

        <!-- Opcije za ponavljanje -->
        <LinearLayout
            android:id="@+id/layoutRepeatOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView android:text="Interval ponavljanja"
                android:textColor="#616161"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <EditText
                    android:id="@+id/inputRepeatInterval"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="npr. 2"
                    android:inputType="number"
                    android:background="@android:color/white"
                    android:padding="10dp"/>
                <Spinner
                    android:id="@+id/spinnerRepeatUnit"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/white"
                    android:padding="10dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Datum početka -->
        <Button
            android:id="@+id/btnSelectStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Odaberi datum početka"
            android:backgroundTint="#3F51B5"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>

        <!-- Datum završetka (samo za ponavljajuće) -->
        <Button
            android:id="@+id/btnSelectEndDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Odaberi datum završetka"
            android:backgroundTint="#3F51B5"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Dodaj dugme -->
        <Button
            android:id="@+id/btnAddTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DODAJ ZADATAK"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:padding="14dp"/>

    </LinearLayout>
</ScrollView>

