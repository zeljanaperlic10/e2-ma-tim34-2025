<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- SAVEZ INFO -->
    <TextView
        android:id="@+id/allianceNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Naziv saveza"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/leaderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vođa:"
        android:textSize="15sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/membersText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Članovi:"
        android:textSize="13sp"
        android:layout_marginTop="2dp"/>

    <!-- MISIJA STATUS -->
    <TextView
        android:id="@+id/missionStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nema aktivne misije"
        android:textSize="15sp"
        android:textColor="#FF5722"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <!-- BOSS HP (vidljivo samo kada je misija aktivna) -->
    <TextView
        android:id="@+id/tvBossHpLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HP bosa misije:"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:visibility="gone"/>

    <ProgressBar
        android:id="@+id/progressBossHp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:progressTint="#D32F2F"
        android:layout_marginTop="4dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvBossHp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#D32F2F"
        android:layout_marginTop="2dp"
        android:visibility="gone"/>

    <!-- DUGMAD (Pokreni / Napusti / Ukini / Napredak) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/startMissionBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pokreni misiju"
            android:visibility="gone"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnMissionProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Napredak misije"
            android:visibility="gone"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/leaveAllianceBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Napusti"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnDeleteAlliance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ukini savez"
            android:backgroundTint="#F44336"
            android:visibility="gone"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginVertical="12dp"/>

    <!-- ČET -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Čet saveza"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F5F5"
        android:padding="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Upiši poruku..."
            android:padding="10dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/sendMessageBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pošalji"/>
    </LinearLayout>

    <!-- LISTA ČLANOVA (skrivena, služi adapteru) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/membersRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

</LinearLayout>