<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#3F51B5"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Izaberi opremu"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnStartBattle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Započni borbu"
            android:textColor="@android:color/white"
            android:backgroundTint="#F44336"
            android:textSize="13sp"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Izaberi opremu koja će ti pomoći u borbi:"
        android:textSize="14sp"
        android:textColor="#616161"
        android:padding="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEquipment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false"/>

    <TextView
        android:id="@+id/tvNoEquipment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Nemaš opremu.\nPobedi bosa da dobiješ opremu!"
        android:textSize="14sp"
        android:textColor="#9E9E9E"
        android:gravity="center"
        android:visibility="gone"/>

</LinearLayout>